# build_bsp.tcl - build UNMODIFIED Xilinx standalone-BSP applications for ZynqSim.
#
# Run with Vitis 2022.1's xsct (no GUI, no Vivado needed):
#
#   set ZS_WS=C:\some\empty\scratch\dir          (becomes the Vitis workspace; deleted first)
#   set ZS_OUT=<repo>\zynqsim\fixtures\bsp       (where the ELFs are copied)
#   C:\Xilinx\Vitis\2022.1\bin\xsct.bat build_bsp.tcl
#
# Optional: ZS_XSA (default zs_ps_all.xsa next to this script), XILINX_VITIS (default C:/Xilinx/Vitis/2022.1),
# ZS_ONLY (a Tcl list of app names: build just those).
#
# What it does (see SOURCE.md):
#   1. platform create -hw <xsa> -proc ps7_cortexa9_0 -os standalone; the BSP is generated from
#      the Vitis install (standalone_v7_7 + the PS7 drivers), compiled -Os without -g.
#   2. Two apps come from Xilinx's own application templates, generated by Vitis:
#      "Hello World" and "Peripheral Tests" (the latter writes testperiph.c from the drivers'
#      *_tapp.tcl scripts and copies the drivers' example sources).
#   3. Every other app is ONE Xilinx driver example file (embeddedsw/XilinxProcessorIPLib/
#      drivers/<drv>/examples/*.c). Those files carry their own main(); they are copied from
#      the Vitis install into the workspace, imported into an "Empty Application(C)" and
#      built as they are. This script contains no C and no edit of any Xilinx source.
#   4. Each ELF is copied to ZS_OUT/<name>.elf.
#
# The Xilinx sources are NOT in this repository: only this script and the resulting ELFs.

proc env_or {name default} {
    if {[info exists ::env($name)] && $::env($name) ne ""} { return $::env($name) }
    return $default
}

set here  [file dirname [file normalize [info script]]]
set ws    [file normalize [env_or ZS_WS ""]]
set out   [file normalize [env_or ZS_OUT $here]]
set xsa   [file normalize [env_or ZS_XSA [file join $here zs_ps_all.xsa]]]
set vitis [file normalize [env_or XILINX_VITIS C:/Xilinx/Vitis/2022.1]]
set only  [env_or ZS_ONLY ""]
if {$ws eq "" || $ws eq [pwd]} { error "set ZS_WS to an empty scratch directory (it is deleted)" }
if {![file exists $xsa]} { error "missing $xsa" }
set drivers [file join $vitis data embeddedsw XilinxProcessorIPLib drivers]

# Applications from Xilinx's application templates.
set templates {
    bsp_hello_world       {Hello World}
    bsp_peripheral_tests  {Peripheral Tests}
}

# Single Xilinx driver examples, each with its own main(): name, driver prefix, the example's
# files (a main file, plus the helpers it needs where the driver ships them next to it).
set examples {
    bsp_gpiops_polled    gpiops   xgpiops_polled_example.c
    bsp_gpiops_intr      gpiops   xgpiops_intr_example.c
    bsp_uartps_polled    uartps   xuartps_polled_example.c
    bsp_uartps_intr      uartps   xuartps_intr_example.c
    bsp_uartps_selftest  uartps   xuartps_selftest_example.c
    bsp_ttcps_tapp       ttcps    xttcps_tapp_example.c
    bsp_ttcps_intr       ttcps    xttcps_intr_example.c
    bsp_ttcps_lowlevel   ttcps    xttcps_low_level_example.c
    bsp_scugic           scugic   xscugic_example.c
    bsp_scugic_lowlevel  scugic   xscugic_low_level_example.c
    bsp_scutimer_polled  scutimer xscutimer_polled_example.c
    bsp_scutimer_intr    scutimer xscutimer_intr_example.c
    bsp_scuwdt_polled    scuwdt   xscuwdt_polled_example.c
    bsp_xadcps_polled    xadcps   xadcps_polled_printf_example.c
    bsp_dmaps_intr       dmaps    xdmaps_example_w_intr.c
    bsp_qspips_selftest  qspips   xqspips_selftest_example.c
    bsp_spips_selftest   spips    xspips_selftest_example.c
    bsp_iicps_selftest   iicps    xiicps_selftest_example.c
    bsp_canps_polled     canps    xcanps_polled_example.c
    bsp_devcfg_selftest  devcfg   xdevcfg_selftest_example.c
    bsp_sdps_raw         sdps     xsdps_raw_example.c
    bsp_emacps_intr_dma  emacps   {xemacps_example_intr_dma.c xemacps_example_util.c xemacps_example.h}
}

file delete -force $ws
file mkdir $ws
setws $ws

platform create -name zsplat -hw $xsa -proc ps7_cortexa9_0 -os standalone
domain active standalone_domain
# Size: -Os and no -g for the BSP libraries (the defaults are "-O2 -c" and "... -g ...").
bsp config compiler_flags "-Os -c"
bsp config extra_compiler_flags "-mcpu=cortex-a9 -mfpu=vfpv3 -mfloat-abi=hard -nostartfiles -Wall -Wextra -fno-tree-loop-distribute-patterns -ffunction-sections -fdata-sections"
platform generate

set libsrc [file join $ws zsplat ps7_cortexa9_0 standalone_domain bsp ps7_cortexa9_0 libsrc]

proc finish_app {name} {
    global ws out
    app config -name $name build-config release
    app config -name $name compiler-optimization {Optimize for size (-Os)}
    app build -name $name
    set elf [file join $ws $name Release $name.elf]
    if {![file exists $elf]} { error "build did not produce $elf" }
    file copy -force $elf [file join $out $name.elf]
    puts "BUILT: $name -> [file join $out $name.elf] ([file size $elf] bytes)"
}

foreach {name tmpl} $templates {
    if {$only ne "" && [lsearch -exact $only $name] < 0} continue
    app create -name $name -platform zsplat -domain standalone_domain -template $tmpl
    finish_app $name
}

foreach {name drv files} $examples {
    if {$only ne "" && [lsearch -exact $only $name] < 0} continue
    # The driver version the BSP actually uses (libsrc/<drv>_vX_Y), its examples live in the install.
    set bspdrv [lindex [lsort [glob -nocomplain -directory $libsrc -tails ${drv}_v*]] end]
    if {$bspdrv eq ""} { puts "SKIPPED: $name (driver $drv is not in this BSP)"; continue }
    set stage [file join $ws _stage $name]
    file mkdir $stage
    foreach file $files {
        set src [file join $drivers $bspdrv examples $file]
        if {![file exists $src]} { error "missing Xilinx example $src" }
        file copy -force $src $stage
    }
    app create -name $name -platform zsplat -domain standalone_domain -template {Empty Application(C)}
    importsources -name $name -path $stage
    finish_app $name
}
puts "ALL DONE"
